{
  "name": "mediashare-user-svc",
  "version": 2,
  "builds": [
    {
      "src": "dist/apps/user-svc/main.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/apps/user-svc/main.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PORT": "3001"
  }
}
